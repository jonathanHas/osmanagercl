APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# POS Database Connection (uniCenta)
# Uncomment and configure when ready to connect to POS system
# POS_DB_HOST=127.0.0.1
# POS_DB_PORT=3306
# POS_DB_DATABASE=unicenta
# POS_DB_USERNAME=readonly_user
# POS_DB_PASSWORD=

# OSAccounts Integration
# Path to OSAccounts invoice storage files (for attachment import)
OSACCOUNTS_FILE_PATH=/var/www/html/OSManager/invoice_storage

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Invoice parsing runs on its own queue so a large upload cannot block coffee/KDS jobs.
# A worker MUST be running for this queue or uploaded invoices sit at status "uploaded"
# forever: php artisan queue:work --queue=invoices
# See scripts/deployment/setup/setup-dedicated-workers.sh for the supervisor setup.
INVOICE_PARSING_QUEUE=invoices

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Udea Supplier Integration
# Uncomment and configure when ready to test Udea scraping
# UDEA_BASE_URI=https://www.udea.nl
# UDEA_USERNAME=your_username
# UDEA_PASSWORD=your_password
# UDEA_TIMEOUT=30
# UDEA_RATE_LIMIT_DELAY=2
# UDEA_CACHE_TTL=3600

# BookStack procedures (SOPs). Read-only API token; blank URL switches the feature off.
# BOOKSTACK_URL=http://bookstack.internal
# BOOKSTACK_TOKEN_ID=your_token_id
# BOOKSTACK_TOKEN_SECRET=your_token_secret
# BOOKSTACK_TIMEOUT=3
# BOOKSTACK_SCREEN_TAG=screen

# AI providers (see docs/features/ai-integration.md). Set the key for each provider you
# pick at /tools/ai-diagnostics; then run php artisan config:cache && php artisan queue:restart.
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Zebra label printer (CUPS/IPP). The print spool lives on this host, not the web server.
ZEBRA_PRINTER_HOST=10.42.1.71
ZEBRA_PRINTER_PORT=631
ZEBRA_PRINTER_NAME=ZTC-GX430t
ZEBRA_PRINTER_TIMEOUT=15

# Nightly backups (spatie/laravel-backup — see docs/development/backups.md).
# BACKUP_PATH must be OUTSIDE the project directory and writable by the user
# that runs the scheduler (www-data on production).
BACKUP_PATH=/var/backups/osmanager
BACKUP_NOTIFICATION_EMAIL=
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_MAX_STORAGE_MB=30000
# DB_DUMP_BINARY_PATH=/usr/bin
